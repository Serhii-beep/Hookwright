<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Label="Test stack" Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup Label="Container-backed suites" Condition="'$(RequiresDocker)' == 'true'">
    <AssemblyAttribute Include="Xunit.TraitAttribute">
      <_Parameter1>Requires</_Parameter1>
      <_Parameter2>Docker</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup Label="Analyzer relaxations">
    <!-- CA1707: underscores in identifiers. Test names read as
         Method_Condition_ExpectedResult, which is deliberate. -->
    <!-- CA2007: ConfigureAwait. No synchronization context in a test host. -->
    <!-- CA1054: URI parameters should not be strings. xUnit can only pre-enumerate
         theory rows whose values it can serialize, and System.Uri is not among them.
         Passing Uri through MemberData makes the theory undiscoverable by name and it
         appears twice in Test Explorer, so URI test inputs are strings. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1054</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
